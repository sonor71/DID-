{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "headers": [{
    "source": "/(.*)",
    "headers": [
      {"key":"X-Content-Type-Options","value":"nosniff"},
      {"key":"Referrer-Policy","value":"strict-origin-when-cross-origin"},
      {"key":"Permissions-Policy","value":"camera=(self), microphone=(self), geolocation=()"},
      {"key":"Content-Security-Policy","value":"default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' https: blob:; media-src 'self' https: blob:; connect-src 'self' https: wss:; frame-ancestors 'none'; base-uri 'self'; form-action 'self'"}
    ]
  }, {
    "source": "/runtime-config.js",
    "headers": [{"key":"Cache-Control","value":"no-store, max-age=0"}]
  }],
  "rewrites": [{"source":"/(.*)","destination":"/index.html"}]
}
