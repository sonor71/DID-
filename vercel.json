{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "cleanUrls": true,
  "rewrites": [
    {
      "source": "/auth-proxy/:path*",
      "destination": "https://bvnbqjhgnlvthkluddfj.supabase.co/auth/v1/:path*"
    },
    {
      "source": "/storage-proxy/:path*",
      "destination": "https://bvnbqjhgnlvthkluddfj.supabase.co/storage/v1/:path*"
    }
  ],
  "headers": [
    {
      "source": "/",
      "headers": [{ "key": "Cache-Control", "value": "no-store, max-age=0" }]
    },
    {
      "source": "/index.html",
      "headers": [{ "key": "Cache-Control", "value": "no-store, max-age=0" }]
    },
    {
      "source": "/src/(.*)",
      "headers": [{ "key": "Cache-Control", "value": "no-store, max-age=0" }]
    }
  ]
}
